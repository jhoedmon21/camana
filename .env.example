# ============================================================
# HidroAlert — Plantilla de variables de entorno
# Copia este archivo como `.env` y completa tus credenciales.
# Todas las variables usan el prefijo HIDROALERT_.
# ============================================================

# --- Google Earth Engine (Módulo 1) ---
# Proyecto de Google Cloud registrado en Earth Engine
HIDROALERT_GEE_PROJECT_ID=
# Ruta al JSON de cuenta de servicio (opcional; si se omite se usa `earthengine authenticate`)
HIDROALERT_GEE_SERVICE_ACCOUNT_JSON=

# --- Google Maps Static API (mapas en informes PDF) ---
HIDROALERT_GOOGLE_MAPS_API_KEY=

# --- Twilio: WhatsApp / SMS (Módulo 4) ---
HIDROALERT_TWILIO_ACCOUNT_SID=
HIDROALERT_TWILIO_AUTH_TOKEN=
HIDROALERT_TWILIO_FROM_SMS=+15000000000
HIDROALERT_TWILIO_FROM_WHATSPAP=whatsapp:+14155238886

# Destinatarios separados por coma (SMS/WhatsApp). WhatsApp requiere prefijo whatsapp:
HIDROALERT_ALERT_RECIPIENTS=+51900000001,whatsapp:+51900000002

# --- Webhook institucional (Defensa Civil / COER) ---
HIDROALERT_WEBHOOK_COER_URL=

# --- Pronóstico (estilo WeatherNext 3) ---
# API key de Google Maps Platform Weather (WeatherNext 3). Si se deja vacía,
# el pronóstico usa Open-Meteo (gratuito, sin key).
HIDROALERT_GOOGLE_WEATHER_API_KEY=
# Capacidad del cauce antes de desbordar (m). Calibrar por quebrada.
HIDROALERT_BANKFULL_DEPTH_M=1.0

# --- Umbrales de alerta (opcional; JSON con claves de AlertThresholds) ---
# HIDROALERT_THRESHOLDS_JSON={"buildings_red": 15, "volume_red_m3": 400000}

# --- Visor 3D (Cesium Ion, opcional) ---
# Token gratuito de https://ion.cesium.com/tokens - activa Cesium World
# Terrain (colinas reales) y OSM Buildings 3D en el Centro de Mando.
HIDROALERT_CESIUM_ION_TOKEN=
