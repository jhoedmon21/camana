{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12@latest",
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{tests/**,docs/**,dashboard/**,scripts/**,.pytest_cache/**,reports/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
